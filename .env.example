# --- Juzt · variables de entorno ---
# Copia este archivo a .env.local y completa los valores reales.

# URL pública del sitio (usada por metadata, sitemap y Open Graph).
NEXT_PUBLIC_SITE_URL="https://juzt.com.co"

# --- Envío del formulario de contacto (opcional pero recomendado) ---
# El endpoint /api/contact valida y sanitiza SIEMPRE. Solo enviará correo real
# si estas variables están configuradas; de lo contrario registra la solicitud
# en el log del servidor y responde con un aviso claro (no simula un envío).
#
# Proveedor SMTP genérico o transaccional (Resend, Postmark, SES, etc.).
CONTACT_TO_EMAIL="gerente@juzt.com.co"
CONTACT_FROM_EMAIL="no-reply@juzt.com.co"

# Si usas Resend:
# RESEND_API_KEY=""

# Si usas SMTP directo:
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
